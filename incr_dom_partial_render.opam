opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/incr_dom_partial_render"
bug-reports: "https://github.com/public-release-reloaded/incr_dom_partial_render/issues"
dev-repo: "git+https://github.com/public-release-reloaded/incr_dom_partial_render.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/incr_dom_partial_render/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "incr_dom" {>= "v0.18~" & < "v0.19~"}
  "incr_map" {>= "v0.18~" & < "v0.19~"}
  "incremental" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_pattern_bind" {>= "v0.18~" & < "v0.19~"}
  "splay_tree" {>= "v0.18~" & < "v0.19~"}
  "virtual_dom" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "js_of_ocaml" {>= "6.3.0"}
  "js_of_ocaml-ppx" {>= "6.0.0"}
]
available: arch != "x86_32"
synopsis: "A library for simplifying rendering of large amounts of data"
description: "
This library provides tools for rendering of tabular data efficiently, in particular supporting _partial rendering_, i.e. only rendering a subset of the widgets that are logically in the view, depending on what is expected to be visible to the end user.
"
